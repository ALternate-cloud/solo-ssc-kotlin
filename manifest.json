      "url": "/#tab-vault",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "share_target": {
    "action": "/#tab-vault",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/#tab-vault",
      "name": "SSC Study Notes",
      "accept": {
        "text/plain": [".txt", ".json"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+ssc",
      "url": "/?quest=%s"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 480
  },
  "note_taking": {
    "new_note_url": "/#tab-focus"
  },
  "widgets": [
    {
      "name": "Daily Quest Tracker",
